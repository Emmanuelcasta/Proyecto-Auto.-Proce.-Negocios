# Database - PostgreSQL (Railway provee esta variable automáticamente)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sysclock_nomina

# JWT
JWT_SECRET_KEY=cambiar-por-un-secreto-seguro-generado-con-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=7

# Make.com (webhooks)
MAKE_API_KEY=

# CORS - Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment: development | production
ENVIRONMENT=development
